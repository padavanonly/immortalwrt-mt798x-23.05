From: medyma <aneylovemzy@gmail.com>
Date: Thu, 22 May 2026 14:00:00 +0200
Subject: [PATCH 6.6] net: sfp: add 1G reprobe watchdog for media converters

Copper modules may advertise 10G at power-on and only switch to 1G after
locking a link partner. For modules confirmed by 2782 to have no RollBall
bridge, re-read the module when the link is not stable within 60s (5
attempts). The worker holds rtnl_lock then sm_mutex and replays
REMOVE/INSERT in one critical section.

Signed-off-by: medyma <aneylovemzy@gmail.com>
---
 drivers/net/phy/sfp.c | 78 +++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 76 insertions(+), 2 deletions(-)

diff --git a/drivers/net/phy/sfp.c b/drivers/net/phy/sfp.c
index 63c4713..a9138d2 100644
--- a/drivers/net/phy/sfp.c
+++ b/drivers/net/phy/sfp.c
@@ -207,6 +207,19 @@ static const enum gpiod_flags gpio_flags[] = {
 #define T_PROBE_RETRY_SLOW	msecs_to_jiffies(5000)
 #define R_PROBE_RETRY_SLOW	12
 
+/* T_LINK_FAIL: how long we wait for a stable link after selecting the host
+ * interface before re-reading the module. Some active copper SFP+ modules
+ * (e.g. RTL8261BE based) advertise 10GBASE-T at power-on and only switch to
+ * 1000BASE-T once they have locked a 1G link partner; if the host probed them
+ * while they still advertised 10G it stays stuck on 10GBASE-R and never links.
+ * Re-reading the module picks up the changed advertisement. T_LINK_STABLE is
+ * how long the link must stay up to be considered good. R_REPROBE bounds the
+ * number of re-read attempts.
+ */
+#define T_LINK_FAIL		msecs_to_jiffies(60000)
+#define T_LINK_STABLE		msecs_to_jiffies(5000)
+#define R_REPROBE		5
+
 /* SFP modules appear to always have their PHY configured for bus address
  * 0x56 (which with mdio-i2c, translates to a PHY address of 22).
  * RollBall SFPs access phy via SFP Enhanced Digital Diagnostic Interface
@@ -262,6 +275,7 @@ struct sfp {
 
 	struct delayed_work poll;
 	struct delayed_work timeout;
+	struct delayed_work reprobe;
 	struct mutex sm_mutex;			/* Protects state machine */
 	unsigned char sm_mod_state;
 	unsigned char sm_mod_tries_init;
@@ -270,6 +284,9 @@ struct sfp {
 	unsigned short sm_state;
 	unsigned char sm_fault_retries;
 	unsigned char sm_phy_retries;
+	unsigned char sm_reprobe_tries;
+	bool sm_reprobing;
+	bool sm_reprobe_enabled;
 
 	struct sfp_eeprom_id id;
 	unsigned int module_power_mW;
@@ -1872,7 +1889,8 @@ static int sfp_sm_probe_phy(struct sfp *sfp, int addr, bool is_c45)
 static void sfp_sm_link_up(struct sfp *sfp)
 {
 	sfp_link_up(sfp->sfp_bus);
-	sfp_sm_next(sfp, SFP_S_LINK_UP, 0);
+	sfp_sm_next(sfp, SFP_S_LINK_UP,
+		    sfp->sm_reprobe_enabled ? T_LINK_STABLE : 0);
 }
 
 static void sfp_sm_link_down(struct sfp *sfp)
@@ -2432,6 +2450,7 @@ static int sfp_sm_mod_probe(struct sfp *sfp, bool report)
 
 	sfp->tx_fault_ignore = false;
 	sfp->no_rollball_bridge = false;
+	sfp->sm_reprobe_enabled = false;
 
 	if (sfp->id.base.extended_cc == SFF8024_ECC_10GBASE_T_SFI ||
 	    sfp->id.base.extended_cc == SFF8024_ECC_10GBASE_T_SR ||
@@ -2454,6 +2473,7 @@ static int sfp_sm_mod_probe(struct sfp *sfp, bool report)
 
 	if (sfp->quirk && sfp->quirk->fixup)
 		sfp->quirk->fixup(sfp);
+
 	mutex_unlock(&sfp->st_mutex);
 
 	return 0;
@@ -2508,6 +2528,10 @@ static void sfp_sm_module(struct sfp *sfp, unsigned int event)
 
 	/* Handle remove event globally, it resets this state machine */
 	if (event == SFP_E_REMOVE) {
+		if (!sfp->sm_reprobing) {
+			sfp->sm_reprobe_enabled = false;
+			cancel_delayed_work(&sfp->reprobe);
+		}
 		sfp_sm_mod_remove(sfp);
 		sfp_sm_mod_next(sfp, SFP_MOD_EMPTY, 0);
 		return;
@@ -2529,6 +2553,9 @@ static void sfp_sm_module(struct sfp *sfp, unsigned int event)
 			sfp_sm_mod_next(sfp, SFP_MOD_PROBE, T_SERIAL);
 			sfp->sm_mod_tries_init = R_PROBE_RETRY_INIT;
 			sfp->sm_mod_tries = R_PROBE_RETRY_SLOW;
+			if (!sfp->sm_reprobing)
+				sfp->sm_reprobe_tries = R_REPROBE;
+			sfp->sm_reprobing = false;
 		}
 		break;
 
@@ -2710,6 +2737,7 @@ static void sfp_sm_main(struct sfp *sfp, unsigned int event)
 				sfp_sm_next(sfp, SFP_S_FAIL, 0);
 				break;
 			}
+			sfp->sm_reprobe_enabled = sfp->no_rollball_bridge;
 			sfp->sm_phy_retries = R_PHY_RETRY;
 			goto phy_probe;
 		}
@@ -2742,6 +2770,14 @@ static void sfp_sm_main(struct sfp *sfp, unsigned int event)
 			sfp_sm_next(sfp, SFP_S_FAIL, 0);
 			break;
 		}
+		/* Arm the re-probe watchdog: if the link does not become
+		 * stable within T_LINK_FAIL, re-read the module in case it
+		 * changed its advertised capabilities.
+		 *
+		 * (padavanonly 999-2764 precedes us here: ret==ENODEV||EINVAL)
+		 */
+		if (sfp->sm_reprobe_enabled && sfp->sm_reprobe_tries)
+			mod_delayed_work(system_wq, &sfp->reprobe, T_LINK_FAIL);
 		sfp_sm_link_check_los(sfp);
 
 		/* Reset the fault retry count */
@@ -2763,7 +2799,12 @@ static void sfp_sm_main(struct sfp *sfp, unsigned int event)
 		break;
 
 	case SFP_S_LINK_UP:
-		if (event == SFP_E_TX_FAULT) {
+		if (event == SFP_E_TIMEOUT) {
+			/* Link has stayed up for T_LINK_STABLE: the module is
+			 * happy with the selected interface, stop the watchdog.
+			 */
+			cancel_delayed_work(&sfp->reprobe);
+		} else if (event == SFP_E_TX_FAULT) {
 			sfp_sm_link_down(sfp);
 			sfp_sm_fault(sfp, SFP_S_TX_FAULT, true);
 		} else if (sfp_los_event_active(sfp, event)) {
@@ -3013,6 +3054,36 @@ static void sfp_poll(struct work_struct *work)
 		mod_delayed_work(system_wq, &sfp->poll, poll_jiffies);
 }
 
+static void sfp_reprobe(struct work_struct *work)
+{
+	struct sfp *sfp = container_of(work, struct sfp, reprobe.work);
+
+	rtnl_lock();
+	mutex_lock(&sfp->sm_mutex);
+
+	if (!sfp->sm_reprobe_enabled || !sfp->sm_reprobe_tries ||
+	    !(sfp->state & SFP_F_PRESENT) ||
+	    sfp->sm_state == SFP_S_LINK_UP)
+		goto unlock;
+
+	--sfp->sm_reprobe_tries;
+	dev_info(sfp->dev,
+		 "link not established, re-reading module (%u tries left)\n",
+		 sfp->sm_reprobe_tries);
+
+	/* Replicate a physical remove/insert so the module is re-read and the
+	 * upstream interface is re-selected from its current advertisement,
+	 * without allowing a real state-machine event between the two.
+	 */
+	sfp->sm_reprobing = true;
+	__sfp_sm_event(sfp, SFP_E_REMOVE);
+	__sfp_sm_event(sfp, SFP_E_INSERT);
+
+unlock:
+	mutex_unlock(&sfp->sm_mutex);
+	rtnl_unlock();
+}
+
 static struct sfp *sfp_alloc(struct device *dev)
 {
 	struct sfp *sfp;
@@ -3028,6 +3099,7 @@ static struct sfp *sfp_alloc(struct device *dev)
 	mutex_init(&sfp->st_mutex);
 	INIT_DELAYED_WORK(&sfp->poll, sfp_poll);
 	INIT_DELAYED_WORK(&sfp->timeout, sfp_timeout);
+	INIT_DELAYED_WORK(&sfp->reprobe, sfp_reprobe);
 
 	sfp_hwmon_init(sfp);
 
@@ -3042,6 +3114,7 @@ static void sfp_cleanup(void *data)
 
 	cancel_delayed_work_sync(&sfp->poll);
+	cancel_delayed_work_sync(&sfp->reprobe);
 	cancel_delayed_work_sync(&sfp->timeout);
 	if (sfp->i2c_mii) {
 		mdiobus_unregister(sfp->i2c_mii);
 		mdiobus_free(sfp->i2c_mii);
@@ -3229,6 +3302,7 @@ static void sfp_shutdown(struct platform_device *pdev)
 
 	cancel_delayed_work_sync(&sfp->poll);
+	cancel_delayed_work_sync(&sfp->reprobe);
 	cancel_delayed_work_sync(&sfp->timeout);
 }
 
 static struct platform_driver sfp_driver = {
